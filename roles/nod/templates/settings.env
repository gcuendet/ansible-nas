# {{ ansible_managed }}
COMPOSE_PROJECT_NAME=nod
NOD_IMAGE_TAG={{ nod_version }}
NOD_ENV_FILE={{ nod_directory }}/settings.env
PORT={{ nod_port }}
NOD_BIND_ADDRESS=127.0.0.1
NOD_PUBLIC_URL={{ nod_public_url }}
NOD_ANALYTICS_ENABLED=false
NOD_SERVER_MEMORY={{ nod_server_memory }}
NOD_BROWSER_MEMORY={{ nod_browser_memory }}
NOD_WORKSPACE_MEMORY={{ nod_workspace_memory }}
